# NetBox instance to connect to. Point this at your own installation later.
NETBOX_URL=https://demo.netbox.dev

# API token from your NetBox user profile (Admin > API Tokens). Required for
# both reads and writes. For the public demo, create a free account at
# https://demo.netbox.dev/plugins/demo/login/ then generate a token from
# your user profile.
NETBOX_TOKEN=

# When true, all create/update/delete tools are disabled and the client only
# ever reads. Recommended when pointing at a real installation until you're
# confident in the setup.
NETBOX_MCP_READ_ONLY=false

# Set to false only if your NetBox instance uses a self-signed certificate.
NETBOX_VERIFY_SSL=true
